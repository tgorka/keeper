{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keeper",
  "version": "0.8.19",
  "identifier": "dev.tgorka.keeper",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../.."
    },
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "keeper",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick-capture",
        "url": "capture.html",
        "title": "keeper — quick note",
        "width": 560,
        "height": 340,
        "minWidth": 320,
        "minHeight": 240,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["keeper"]
      }
    },
    "updater": {
      "endpoints": ["https://github.com/tgorka/keeper/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3M0U0OEZGNDMzNThDREYKUldUZmpEVkQvMGcrOXc0dkcxbTdFRnpyeWNLTVlVYTJBcm5FQ0lwTVUrMWZlVytpLzIyOS96K1kK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/keeper-rec"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./keeper-rec.entitlements"
    }
  }
}
