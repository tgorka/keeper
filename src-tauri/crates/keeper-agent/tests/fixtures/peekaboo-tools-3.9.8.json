            "description": "Simple menu item to click (for non-nested items)",
            "type": "string"
          },
          "path": {
            "description": "Menu path for nested items (e.g., 'File > Save As...' or 'Edit > Copy')",
            "type": "string"
          },
          "title": {
            "description": "Title of system menu extra (for click-extra action)",
            "type": "string"
          }
        },
        "required": ["action"],
        "type": "object"
      },
      "name": "menu"
