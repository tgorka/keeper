    {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "app_target": {
            "description": "Optional. Specifies the app/window to inspect via Accessibility.\nOmit, use an empty string, or use 'frontmost' for the current foreground application.\nUse 'AppName' (e.g., 'Safari') for a specific application.\nUse 'PID:PROCESS_ID' to target a specific process.\nUse 'AppName:WindowTitle' or 'PID:PROCESS_ID:WindowTitle' for a specific window title.\nScreen and menu bar targets require screenshots; use `see` for those.",
            "type": "string"
          },
          "max_children": {
            "description": "Optional. Maximum AX children per node. Env fallback: PEEKABOO_AX_MAX_CHILDREN.\nIncrease this for flat Qt/Electron panels with many sibling controls.",
            "type": "number"
          },
          "max_depth": {
            "description": "Optional. Maximum AX traversal depth. Env fallback: PEEKABOO_AX_MAX_DEPTH.",
            "type": "number"
          },
          "max_elements": {
            "description": "Optional. Maximum AX elements to collect. Env fallback: PEEKABOO_AX_MAX_ELEMENTS.",
            "type": "number"
          },
          "snapshot": {
            "description": "Optional. Snapshot ID for UI automation tracking. A new snapshot is created when absent.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "inspect_ui"
    },
    {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "Target application when listing windows. Accepts app name,\nbundle ID, or PID (e.g., PID:663). Partial names are fuzzy matched.",
            "type": "string"
          },
          "include_window_details": {
            "description": "Extra data for each window (application_windows only).\nChoose any combination of `ids`, `bounds`, or `off_screen`.",
            "items": {
              "enum": ["ids", "bounds", "off_screen"],
              "type": "string"
            },
            "type": "array",
            "uniqueItems": false
          },
          "item_type": {
            "description": "Controls what is listed. Defaults to:\n- application_windows when `app` is provided\n- running_applications otherwise\n\nValid values:\n- running_applications\n- application_windows\n- server_status",
            "enum": ["running_applications", "application_windows", "server_status"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list"
    },
    {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "Action to perform. Use 'list' to discover menus, 'click' to\ninteract with menu items, 'click-extra' for system menu extras,\nor 'list-all' for all menus.",
            "enum": ["list", "click", "click-extra", "list-all"],
            "type": "string"
          },
          "app": {
            "description": "Target application name, bundle ID, or process ID (required for list and click actions)",
