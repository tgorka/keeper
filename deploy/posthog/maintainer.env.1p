# Maintainer processes only. Never source this into a build or use VITE_ variables.
# Main resolves these existing references; no project or credential creation.
POSTHOG_PERSONAL_API_KEY=op://tg/keeper-posthog-personal-api-key/credential
POSTHOG_PROJECT_API_KEY=op://tg/keeper-posthog-project-api-key/credential
POSTHOG_PROJECT_ID=op://tg/keeper-posthog-project-api-key/project-id
# The vault hostname is bare; the API client deliberately requires an exact HTTPS origin.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_INGEST_HOST=https://us.i.posthog.com
