{
  "manifestVersion": 1,
  "migrations": "./migrations",
  "queries": "./queries",
  "naming": "preserve",
  "output": {
    "ir": "./syncular.ir.json",
    "module": "./syncular.generated.ts",
    "queryIr": "./syncular.queries.ir.json",
    "queries": "./syncular.queries.ts"
  },
  "schemaVersions": [
    { "version": 1, "through": "0001_initial" },
    { "version": 2, "through": "0002_session_trust" },
    { "version": 3, "through": "0003_agent_profile_tools" },
    { "version": 4, "through": "0004_grants_settings_drives" },
    { "version": 5, "through": "0005_session_drive_ticks" },
    { "version": 6, "through": "0006_knowledge_graph" },
    { "version": 7, "through": "0007_knowledge_graph_contents" },
    { "version": 8, "through": "0008_knowledge_graph_review" },
    { "version": 9, "through": "0009_knowledge_graph_history" },
    { "version": 10, "through": "0010_files" },
    { "version": 11, "through": "0011_settings" },
    { "version": 12, "through": "0012_jobs" },
    { "version": 13, "through": "0013_knowledge_graph_file_refs" }
  ],
  "tables": [
    { "name": "actors", "scopes": ["dir:{dir}"] },
    { "name": "clients", "scopes": ["dir:{dir}"] },
    { "name": "agent_profiles", "scopes": ["dir:{dir}"] },
    { "name": "sessions", "scopes": [{ "pattern": "session:{session}", "column": "id" }] },
    {
      "name": "session_members",
      "scopes": [
        { "pattern": "session:{session}", "column": "session_id" },
        { "pattern": "member:{member}", "column": "actor_id" }
      ]
    },
    {
      "name": "claims",
      "scopes": [{ "pattern": "session:{session}", "column": "session_id" }]
    },
    {
      "name": "session_tool_switches",
      "scopes": [{ "pattern": "session:{session}", "column": "session_id" }]
    },
    {
      "name": "session_settings",
      "scopes": [{ "pattern": "session:{session}", "column": "session_id" }]
    },
    {
      "name": "session_drives",
      "scopes": [{ "pattern": "session:{session}", "column": "session_id" }]
    },
    {
      "name": "turn_chunks",
      "scopes": [{ "pattern": "session:{session}", "column": "session_id" }]
    },
    {
      "name": "attachments",
      "scopes": [{ "pattern": "session:{session}", "column": "session_id" }]
    },
    { "name": "messages", "scopes": [{ "pattern": "page:{page}", "column": "page_key" }] },
    { "name": "reasoning", "scopes": [{ "pattern": "trace:{trace}", "column": "page_key" }] },
    { "name": "tool_calls", "scopes": [{ "pattern": "trace:{trace}", "column": "page_key" }] },
    { "name": "approvals", "scopes": [{ "pattern": "trace:{trace}", "column": "page_key" }] },
    {
      "name": "instance_prefs",
      "scopes": [{ "pattern": "actor:{actor}", "column": "person_actor" }]
    },
    {
      "name": "standing_grants",
      "scopes": [{ "pattern": "person_agent:{person_agent}", "column": "person_agent_key" }]
    },
    {
      "name": "agent_memory",
      "scopes": [
        { "pattern": "agent:{agent}", "column": "agent_actor" },
        { "pattern": "family:{family}", "column": "family" }
      ]
    },
    {
      "name": "kg_events",
      "scopes": [{ "pattern": "kg_history:{kg_history}", "column": "graph" }]
    },
    {
      "name": "kg_event_ops",
      "scopes": [{ "pattern": "kg_history:{kg_history}", "column": "graph" }]
    },
    { "name": "kg_head", "scopes": [{ "pattern": "kg_history:{kg_history}", "column": "graph" }] },
    { "name": "kg_nodes", "scopes": [{ "pattern": "kg_graph:{kg_graph}", "column": "graph" }] },
    { "name": "kg_edges", "scopes": [{ "pattern": "kg_graph:{kg_graph}", "column": "graph" }] },
    { "name": "kg_tags", "scopes": [{ "pattern": "kg_graph:{kg_graph}", "column": "graph" }] },
    { "name": "kg_node_tags", "scopes": [{ "pattern": "kg_graph:{kg_graph}", "column": "graph" }] },
    { "name": "kg_contents", "scopes": [{ "pattern": "kg_graph:{kg_graph}", "column": "graph" }] },
    { "name": "kg_file_refs", "scopes": [{ "pattern": "kg_graph:{kg_graph}", "column": "graph" }] },
    {
      "name": "kg_reviews",
      "scopes": [{ "pattern": "kg_history:{kg_history}", "column": "graph" }]
    },
    {
      "name": "kg_proposals",
      "scopes": [{ "pattern": "kg_proposal:{kg_proposal}", "column": "proposer_actor" }]
    },
    {
      "name": "kg_receipts",
      "scopes": [{ "pattern": "kg_client:{kg_client}", "column": "client_scope" }]
    },
    {
      "name": "files_entries",
      "scopes": [{ "pattern": "files_drive:{files_drive}", "column": "drive_key" }]
    },
    {
      "name": "files_entry_sources",
      "scopes": [{ "pattern": "files_sources:{files_sources}", "column": "domain" }]
    },
    {
      "name": "files_events",
      "scopes": [{ "pattern": "files_page:{files_page}", "column": "page_key" }]
    },
    {
      "name": "files_event_ops",
      "scopes": [{ "pattern": "files_page:{files_page}", "column": "page_key" }]
    },
    {
      "name": "files_head",
      "scopes": [{ "pattern": "files_domain:{files_domain}", "column": "domain" }]
    },
    {
      "name": "files_receipts",
      "scopes": [{ "pattern": "files_client:{files_client}", "column": "client_scope" }]
    },
    {
      "name": "settings_devices",
      "scopes": [{ "pattern": "settings_owner:{settings_owner}", "column": "owner_actor" }]
    },
    {
      "name": "settings_values",
      "scopes": [{ "pattern": "settings_owner:{settings_owner}", "column": "owner_actor" }]
    },
    { "name": "config_values", "scopes": ["dir:{dir}"] },
    { "name": "jobs", "scopes": [{ "pattern": "jobs_page:{jobs_page}", "column": "page_key" }] },
    {
      "name": "job_claims",
      "scopes": [{ "pattern": "jobs_page:{jobs_page}", "column": "page_key" }]
    },
    {
      "name": "job_capabilities",
      "scopes": [{ "pattern": "jobs_nodes:{jobs_nodes}", "column": "domain" }]
    }
  ],
  "subscriptions": [
    { "name": "directory", "scopes": { "dir": "{database}" } },
    { "name": "memberships", "scopes": { "member": "{actorId}" } },
    { "name": "preferences", "scopes": { "actor": "{actorId}" } },
    { "name": "session", "scopes": { "session": "{sessionId}" } },
    { "name": "messagesPage", "scopes": { "page": "{pageKey}" } },
    { "name": "tracePage", "scopes": { "trace": "{pageKey}" } },
    { "name": "standingGrants", "scopes": { "person_agent": "{personAgentKey}" } },
    { "name": "agentMemoryOwn", "scopes": { "agent": "{agentActor}" } },
    { "name": "agentMemoryFamily", "scopes": { "family": "{family}" } },
    { "name": "kgGraph", "scopes": { "kg_graph": "{database}" } },
    { "name": "kgHistory", "scopes": { "kg_history": "{database}" } },
    { "name": "kgReceipts", "scopes": { "kg_client": "{clientScope}" } },
    { "name": "kgProposals", "scopes": { "kg_proposal": "{actorId}" } },
    { "name": "filesDrive", "scopes": { "files_drive": "{driveKey}" } },
    { "name": "filesDomain", "scopes": { "files_domain": "{database}" } },
    { "name": "filesPage", "scopes": { "files_page": "{pageKey}" } },
    { "name": "filesReceipts", "scopes": { "files_client": "{clientScope}" } },
    { "name": "filesSources", "scopes": { "files_sources": "{database}" } },
    { "name": "settingsOwn", "scopes": { "settings_owner": "{actorId}" } },
    { "name": "jobsPage", "scopes": { "jobs_page": "{pageKey}" } },
    { "name": "jobsNodes", "scopes": { "jobs_nodes": "{database}" } }
  ]
}
